# LLM Configuration
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_API_KEY=your_api_key_here

# OpenEMR FHIR Configuration
OPENEMR_FHIR_BASE_URL=http://localhost:8080/fhir
OPENEMR_CLIENT_ID=your_client_id
OPENEMR_CLIENT_SECRET=your_client_secret

# Application Settings
LOG_LEVEL=INFO
AUDIT_LOG_ENABLED=true
MAX_CONCURRENT_REQUESTS=10

# Summary Settings
SUMMARY_DEFAULT_MONTHS=12
MAX_ENCOUNTERS_PER_SUMMARY=50

# HIPAA Mode
HIPAA_MODE=true

# Agent API Authentication
# Shared secret between the Python agent and the OpenEMR PHP module.
# The PHP module reads the same value from CHART_SUMMARIZER_API_KEY.
# Leave empty to disable auth (development only — NEVER empty in production).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AGENT_API_KEY=your_shared_secret_here

# CORS Configuration
# "*" allows all origins — suitable for public Railway/Fly demo deployments.
# In production with a known OpenEMR host, restrict to that domain only:
# CORS_ORIGINS=https://openemr.example.com,http://localhost:8080
CORS_ORIGINS=*