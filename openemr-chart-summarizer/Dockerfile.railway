# Dockerfile for Railway deployment.
# Build context is the REPO ROOT (not agent/).
# agent/Dockerfile is for local `docker compose` where context = agent/.
#
# This file is identical in logic to agent/Dockerfile except all COPY
# paths are prefixed with "agent/".

FROM python:3.12-slim

RUN useradd --create-home --shell /bin/bash app

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY agent/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY agent/src/ ./src/
COPY agent/pyproject.toml ./
RUN pip install --no-cache-dir -e . --no-deps

RUN chown -R app:app /app
USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

CMD ["sh", "-c", "uvicorn chart_summarizer.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
